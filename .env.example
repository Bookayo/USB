# Copy this file to .env and fill in your own keys. NEVER commit .env.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
OPENLOFT_API_KEY=

# Set to 1 to use fake data instead of real API calls (saves credits while building)
USE_FAKES=1

# Set to 1 to remove background noise when cloning a voice (try it in noisy rooms).
# Can make clean recordings sound worse, so leave at 0 in a quiet room.
CLONE_DENOISE=0
